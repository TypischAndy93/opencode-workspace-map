{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.0.26",
  "name": "@opencode/sdk",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./effect": {
      "import": "./dist/effect/index.js",
      "types": "./dist/effect/index.d.ts"
    },
    "./workerd": {
      "import": "./dist/workerd.js",
      "types": "./dist/workerd.d.ts"
    },
    "./workerd/effect": {
      "import": "./dist/effect/workerd.js",
      "types": "./dist/effect/workerd.d.ts"
    }
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test --timeout 5000",
    "typecheck": "tsgo -b",
    "verify:package": "bun run script/verify-package.ts"
  },
  "dependencies": {
    "@opencode/client": "2.0.26",
    "@opencode/core": "2.0.26",
    "@opencode/plugin": "2.0.26",
    "@opencode/schema": "2.0.26",
    "@opencode/server": "2.0.26",
    "@opencode/util": "2.0.26",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@opencode/ai": "2.0.26",
    "@opencode/httpapi-codegen": "2.0.26",
    "@opencode/protocol": "2.0.26",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.0",
    "@typescript/native-preview": "7.0.0-dev.20251207.1"
  }
}

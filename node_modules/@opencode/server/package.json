{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/server",
  "version": "2.0.26",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test --only-failures",
    "typecheck": "tsgo -b",
    "probe:workerd": "bun run script/workerd-probe.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@opencode/core": "2.0.26",
    "@opencode/protocol": "2.0.26",
    "@opencode/schema": "2.0.26",
    "@opencode/simulation": "2.0.26",
    "@opencode/util": "2.0.26",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@opencode/client": "2.0.26",
    "@opencode/plugin": "2.0.26",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.0",
    "@typescript/native-preview": "7.0.0-dev.20251207.1"
  }
}

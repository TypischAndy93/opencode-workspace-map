{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/simulation",
  "version": "2.0.26",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/simulation"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./backend": {
      "import": "./dist/backend/index.js",
      "types": "./dist/backend/index.d.ts"
    },
    "./backend/*": {
      "import": "./dist/backend/*.js",
      "types": "./dist/backend/*.d.ts"
    },
    "./frontend": {
      "import": "./dist/frontend/simulation.js",
      "types": "./dist/frontend/simulation.d.ts"
    },
    "./frontend/*": {
      "import": "./dist/frontend/*.js",
      "types": "./dist/frontend/*.d.ts"
    },
    "./protocol": {
      "import": "./dist/protocol/index.js",
      "types": "./dist/protocol/index.d.ts"
    },
    "./recording": {
      "import": "./dist/recording.js",
      "types": "./dist/recording.d.ts"
    }
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test --timeout 30000 --only-failures",
    "typecheck": "tsgo -b"
  },
  "dependencies": {
    "@opencode/core": "2.0.26",
    "@opencode/ai": "2.0.26",
    "@opencode/plugin": "2.0.26",
    "@opencode/protocol": "2.0.26",
    "@opencode/util": "2.0.26",
    "@opentui/core": "0.5.17",
    "effect": "4.0.0-rc.112",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.0",
    "@types/ws": "8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20251207.1"
  }
}

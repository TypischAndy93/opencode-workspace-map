    "@opentelemetry/semantic-conventions": "^1.43.0",
    "zstd-codec": "^0.1.5"
  },
  "devDependencies": {
    "@opencode/client": "^2.0.20",
    "@opencode/sdk": "^2.0.20",
    "@types/node": "^20.19.43",
    "fast-check": "^4.10.2",
